{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "toolshield": {
      "root": ".",
      "framework": "fastapi",
      "buildCommand": "./build.sh"
    },
    "frontend": {
      "root": "frontend",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "toolshield"
      }
    },
    {
      "source": "/health",
      "destination": {
        "service": "toolshield"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
